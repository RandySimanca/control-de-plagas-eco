PORT=3001
NODE_ENV=development


FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plagcontrol

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────
# Almacenamiento de archivos
# ─────────────────────────────────────────────
# Valores posibles: local | s3
# - local → guarda archivos en ./uploads (Docker / desarrollo)
# - s3    → guarda archivos en AWS S3 o proveedor compatible (producción)
STORAGE_DRIVER=local

# TODO (producción): descomentar y rellenar cuando se migre a S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_ENDPOINT=          # Solo para Cloudflare R2 / DigitalOcean Spaces / MinIO
# AWS_PUBLIC_URL=        # URL pública base del bucket (ej: https://cdn.tudominio.com)
