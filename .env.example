# ============================================================
#  PlagControl - Variables de entorno para Docker Compose
# ============================================================

# ---- Base de datos ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_este_password_seguro
POSTGRES_DB=plagcontrol

# ---- Backend ----
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_min_32chars
JWT_EXPIRES_IN=1d

# ---- Seed: Usuario administrador inicial ----
# Se crea automáticamente al primer arranque del contenedor.
ADMIN_EMAIL=admin.admin@correo.com
ADMIN_PASSWORD=cambia_esta_contraseña_segura
ADMIN_NOMBRE=Administrador

# ---- Frontend (URL del backend visible desde el navegador) ----
# Con el reverse-proxy de Nginx en Docker,  ruta relativa "/api"
# Para desarrollo local sin Docker,  "http://localhost:3001/api"
VITE_API_URL=/api
