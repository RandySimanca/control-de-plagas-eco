# ============================================================
#  PlagControl - Variables de entorno para Docker Compose
#  Copia este archivo como ".env" en la raíz del proyecto y
#  rellena los valores reales. NUNCA subas .env al repositorio.
# ============================================================

# ---- Base de datos ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_este_password_seguro
POSTGRES_DB=plagcontrol

# ---- Backend ----
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_min_32chars
JWT_EXPIRES_IN=1d

# ---- Frontend (URL del backend visible desde el navegador) ----
# Con el reverse-proxy de Nginx en Docker, usa ruta relativa "/api"
# Para desarrollo local sin Docker, usa "http://localhost:3001/api"
VITE_API_URL=/api
